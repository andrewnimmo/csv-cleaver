<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed, notarised build.

  Each entry is here for a reason this application can name, and nothing else
  is: notarisation reviewers and users alike should be able to read this file
  as a claim about what the application needs.

    allow-jit and allow-unsigned-executable-memory
        The JVM. HotSpot compiles bytecode to machine code at runtime and
        executes it from writable memory; a hardened runtime forbids both
        unless declared.

    disable-library-validation
        JNA. The macOS application-menu integration (csv-cleaver.macos) loads
        JNA's native dispatch library, which JNA extracts from its jar at
        runtime — a library not signed with this application's identity.
        Library validation would refuse it, and the About menu item would
        silently never appear. If JNA is ever dropped, drop this with it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
