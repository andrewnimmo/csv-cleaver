;; Babashka task runner. Everything you routinely do to this project, in one
;; short command each. Run `bb tasks` to list them.

{:min-bb-version "1.3.0"

 ;; For locale-lint, which runs natively under bb — no JVM start-up for a
 ;; check that reads a couple of dozen files. Nothing here loads an
 ;; application namespace unless a task asks it to.
 :paths ["src" "dev"]

 ;; For the site task only. Version checked against the live Clojars API on
 ;; 2026-08-06; renders GFM tables, which docs/VERIFICATION.md depends on.
 :deps {markdown-clj/markdown-clj {:mvn/version "1.12.9"}}

 :tasks
 {:requires ([babashka.fs :as fs]
             [cheshire.core :as json]
             [clojure.pprint :as pprint]
             [clojure.string :as str])

  :init
  (do
    (defn clj [& args]
      (let [{:keys [exit]} (shell {:continue true} (str/join " " (cons "clojure" args)))]
        (when-not (zero? exit) (System/exit exit)))))

  run
  {:doc              "Run the application. Extra arguments pass through: bb run --locale ja"
   :override-builtin true
   :task             (apply clj "-M:run" *command-line-args*)}

  api
  {:doc  "Run the local HTTP service with no window, for trying the API. Prints a token and a link to the Swagger page. Extra arguments pass through: bb api --api-input both"
   :task (apply clj "-M:run" "--api" "--headless" *command-line-args*)}

  test
  {:doc  "Run the whole test suite."
   :task (clj "-M:test")}

  mutate
  {:doc  "Break the code on purpose and check the tests notice. Slow — minutes, not seconds. See dev/mutations.edn."
   :task
   ;; A test that has never been seen to fail has not been shown to test
   ;; anything. This applies each deliberate defect in dev/mutations.edn, runs
   ;; the tests that claim to guard it, and puts the source back.
   (let [mutations (read-string (slurp "dev/mutations.edn"))
         dirty     (-> (shell {:out :string} "git status --porcelain") :out str/trim)]
     ;; Refuse on a dirty tree. Every mutation is written to a real source file
     ;; and undone afterwards; if that goes wrong, uncommitted work is what
     ;; would be lost.
     (when (seq dirty)
       (println "Commit or stash first — this edits source files in place.")
       (println dirty)
       (System/exit 1))
     ;; One at a time. Two runs overlapping means one restores a file the other
     ;; has already mutated, and the defect is left in the tree — which happened
     ;; the first time this task was used, and was only noticed because the
     ;; mutation was in a file being watched.
     (let [lock (fs/file "target/mutate.lock")]
       (when (fs/exists? lock)
         (println "Another bb mutate is running (or died). Remove" (str lock)
                  "if you are sure it is not.")
         (System/exit 1))
       (fs/create-dirs "target")
       (spit lock "running"))
     ;; A killed run — Ctrl-C, a closed terminal — must not leave a deliberate
     ;; defect sitting in the tree. It has, twice: once committed by a sweep of
     ;; git add -A, once found only because the file happened to be under
     ;; review. Every original is remembered before it is touched, and this
     ;; hook puts them all back however the process ends. (fn [], not #(...):
     ;; bb.edn is EDN,
     ;; which has no dispatch macro — and no @ deref macro, hence (deref).)
     (def mutate-originals (atom {}))
     (.addShutdownHook (Runtime/getRuntime)
                       (Thread. (fn []
                                  (doseq [[file text] (deref mutate-originals)]
                                    (try (spit file text) (catch Exception _ nil)))
                                  (fs/delete-if-exists (fs/file "target/mutate.lock")))))
     (let [results
           (doall
            (for [{:keys [label file find replace namespace]} mutations]
              (let [original (slurp file)]
                (if-not (str/includes? original find)
                  (do (println "STALE   " label) [:stale label])
                  (try
                    (swap! mutate-originals assoc file original)
                    (spit file (str/replace-first original find replace))
                    (let [{:keys [out err exit]}
                          (shell {:out :string :err :string :continue true}
                                 (str "clojure -M:test --namespace " namespace))
                          noticed (or (not (zero? exit))
                                      (not (str/includes? (str out err)
                                                          "0 failures, 0 errors")))]
                      (println (if noticed "caught  " "MISSED  ") label)
                      [(if noticed :caught :missed) label])
                    (finally
                      (spit file original)
                      (swap! mutate-originals dissoc file)))))))
           bad (remove (comp #{:caught} first) results)]
       (println (format "\n%d of %d mutations caught."
                        (count (filter (comp #{:caught} first) results))
                        (count results)))
       (fs/delete-if-exists (fs/file "target/mutate.lock"))
       (when (seq bad)
         (println "\nThese changed the behaviour of the application and no test failed:")
         (doseq [[verdict label] bad] (println " " (name verdict) label))
         (println "\nA test that cannot fail is not protecting anything.")
         (System/exit 1))))}

  test:fast
  {:doc  "Run everything except the tests that need a JavaFX toolkit."
   :task (clj "-M:test" "--exclude" ":fx")}

  coverage
  {:doc  "Run the tests and write a coverage report to target/coverage."
   :task (clj "-M:coverage")}

  lint
  {:doc  "Run clj-kondo over the source and tests."
   :task (clj "-M:lint")}

  locale-lint
  {:doc  "Forbid default-locale text operations outside csv-cleaver.text and csv-cleaver.i18n. See dev/locale_lint.clj."
   :task (exec 'locale-lint/run)}

  test-tr
  {:doc  "The whole suite under the Turkish locale — the canonical adversary for anything that quietly reads the machine's locale."
   :task (clj "-J-Duser.language=tr" "-J-Duser.country=TR" "-M:test")}

  audit
  {:doc  "Check dependencies against the NIST vulnerability database."
   ;; nvd-clojure 5 wants the classpath to scan handed to it explicitly rather
   ;; than working it out itself, so it is computed here. Scanning the wrong
   ;; classpath — the audit tool's own, say — would report nothing and look
   ;; exactly like a clean result.
   :task (let [cp  (-> (shell {:out :string} "clojure -Spath") :out str/trim)
               ;; The key may live in the environment under either name, or in
               ;; a gitignored file beside the project. Without one nvd-clojure
               ;; refuses to run, which is the right failure: an audit that
               ;; quietly checked nothing would be worse than none at all.
               ;;
               ;; It is passed on as NVD_API_TOKEN because that, and only that,
               ;; is what nvd-clojure 5.3 reads — see nvd.config/populate-settings!.
               ;; NVD_API_KEY is the name everyone reaches for first, including
               ;; NIST's own documentation, so it is accepted here and
               ;; translated rather than left to fail with a message that names
               ;; neither variable.
               key (or (System/getenv "NVD_API_TOKEN")
                       (System/getenv "NVD_API_KEY")
                       (let [f (fs/file ".nvd-api-key")]
                         (when (fs/exists? f) (str/trim (slurp f)))))]
           (when-not key
             (println "No NVD API key. Set NVD_API_KEY, or put the key in")
             (println ".nvd-api-key beside this file. Request one free at")
             (println "https://nvd.nist.gov/developers/request-an-api-key"))
           ;; Only the classpath. The :audit alias already passes the config
           ;; file, and nvd's -main takes exactly two arguments — passing the
           ;; config twice bound the classpath to "nvd-config.edn", which is a
           ;; regular file, so it scanned that one file, found nothing wrong
           ;; with it, and reported a clean audit.
           (let [{:keys [exit]} (shell {:extra-env (when key {"NVD_API_TOKEN" key})
                                        :continue  true}
                                       (str "clojure -M:audit \"" cp "\""))
                 report (fs/file "target/nvd/dependency-check-report.json")
                 scanned (if (fs/exists? report)
                           (count (get (json/parse-string (slurp (str report)) true)
                                       :dependencies))
                           0)]
             ;; A clean result means nothing unless something was actually
             ;; looked at. This is the check that would have caught the bug
             ;; above, which reported "0 vulnerabilities" over an empty scan.
             (println (str "\nScanned " scanned " dependencies."))
             (when (< scanned 10)
               (println "That is too few to be a real scan of this project.")
               (System/exit 1))
             (when-not (zero? exit)
               (System/exit exit))))}

  outdated
  {:doc  "List dependencies that have newer versions."
   :task (clj "-M:outdated")}

  format
  {:doc  "Reformat every source file with cljfmt."
   :task (clj "-M:format" "fix")}

  format:check
  {:doc  "Fail if anything is not formatted as cljfmt would write it."
   :task (clj "-M:format" "check")}

  icons
  {:doc  "Regenerate every platform icon from the geometry in dev/icons.clj."
   :task (do (clj "-M:icons")
             (when (= "Mac OS X" (System/getProperty "os.name"))
               (shell "iconutil -c icns target/icon.iconset -o package/macos/icon.icns")
               (println "Wrote package/macos/icon.icns")))}

  shots
  {:doc  "Render every screen to target/shots as PNG, in both themes."
   :task (clj "-M:shots")}

  site
  {:doc  "Build the documentation site into target/site. Deployed to GitHub Pages by .github/workflows/pages.yml."
   :task (load-file "dev/site.clj")}

  check
  {:doc     "Everything CI runs: format, lint, locale lint, tests (plain and under tr_TR), vulnerabilities."
   :depends [format:check lint locale-lint test test-tr audit]}

  clean
  {:doc  "Remove build output."
   :task (fs/delete-tree "target")}

  uber
  {:doc  "Build the standalone jar."
   :task (clj "-T:build" "uber")}

  package
  {:doc  "Build a native installer for this machine's platform with jpackage."
   ;; The script builds the uberjar itself; doing it here as well built it twice.
   :task (shell (str "./package/build-" (case (System/getProperty "os.name")
                                          ("Mac OS X" "macOS") "mac.sh"
                                          "linux.sh")))}

  brand
  {:doc  "Change branding without editing code:
          bb brand --name \"Acme Splitter\" --accent \"#c2410c\""
   :task
   (let [args    (apply hash-map *command-line-args*)
         file    "resources/branding.edn"
         current (read-string (slurp file))
         ;; bb.edn is EDN, so a regex literal cannot appear here.
         updated (reduce (fn [m [flag value]]
                           (assoc m (keyword (str/replace flag (re-pattern "^--") "")) value))
                         current
                         args)]
     (if (empty? args)
       (do (println "Current branding:")
           (doseq [[k v] (sort-by key current)] (println " " k v))
           (println "\nUsage: bb brand --name \"Acme Splitter\" --accent \"#c2410c\""))
       (do (spit file (with-out-str (pprint/pprint updated)))
           (println "Updated" file)
           (doseq [[k v] (sort-by key updated)] (println " " k v))
           (println "\nRebuild to see the change: bb uber"))))}

  languages
  {:doc  "List the shipped languages and whether each has been reviewed."
   :task (doseq [f (sort (fs/glob "resources/i18n" "*.edn"))]
           (let [{:keys [meta]} (read-string (slurp (str f)))]
             (println (format "%-6s %-12s %s"
                              (:locale meta)
                              (:name meta)
                              (if (:reviewed? meta) "reviewed" "NOT REVIEWED")))))}}}
