{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure            {:mvn/version "1.12.6"}

  ;; cljfx declares javafx-media and javafx-web as hard dependencies. Neither is
  ;; used here, and javafx-web alone carries a WebKit native of ~180 MB, which
  ;; would land in every installer. Excluded, with the modules we do use pinned
  ;; explicitly so every JavaFX artifact resolves at the same version.
  cljfx/cljfx                    {:mvn/version "1.10.361"
                                  :exclusions  [org.openjfx/javafx-media
                                                org.openjfx/javafx-web]}

  org.clojure/tools.cli          {:mvn/version "1.4.256"}

  ;; The optional local HTTP service. Off unless --api is given; see
  ;; docs/API.md and the security note in docs/SECURITY.md.
  ;; msgpack excluded: it reaches here only through transit-java, for a wire
  ;; format this API does not offer (the muuntaja instance in api.server is
  ;; restricted to JSON and EDN, so nothing can negotiate its way to the
  ;; missing class). The jar was abandoned in 2015 under the CPE
  ;; msgpack:msgpack, where every Ruby and Python MessagePack CVE lands on it
  ;; as a false positive — two in the first two days of the audit gate. The
  ;; treadmill ends by not shipping the jar.
  metosin/reitit                 {:mvn/version "0.10.1"
                                  :exclusions  [org.msgpack/msgpack]}
  http-kit/http-kit              {:mvn/version "2.8.1"}
  ring/ring-core                 {:mvn/version "1.15.5"}

  ;; Pinned ahead of what reitit resolves. 2.21.1 carries CVE-2026-54512 and
  ;; -54513 (CVSS 8.1, polymorphic type validation) plus five more; the last of
  ;; them is fixed in 2.21.5. Found by `bb audit` — remove this pin once reitit
  ;; itself resolves to 2.21.5 or later, and check with `bb audit` rather than
  ;; by eye. Checked 2026-09-05: the newest stable reitit is still 0.10.1,
  ;; which still resolves 2.21.1, and the unpinned tree still fails the audit
  ;; on all seven CVEs. The pin stays, and follows drift.
  com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.22.2"}

  io.github.mkpaz/atlantafx-base {:mvn/version "2.1.0"}

  ;; The Objective-C runtime, for the one thing JavaFX cannot do: put About
  ;; into the macOS application menu, which Glass builds natively with no
  ;; public hook. Used only on macOS, in csv-cleaver.macos; harmless elsewhere.
  net.java.dev.jna/jna           {:mvn/version "5.19.1"}

  ;; The newest patch of the 25 LTS line, matching the JDK the installers
  ;; bundle. A 26 GA exists, but changing toolkit line is not drift — it is
  ;; its own change, reviewed with `bb shots` open.
  org.openjfx/javafx-base        {:mvn/version "25.0.4"}
  org.openjfx/javafx-graphics    {:mvn/version "25.0.4"}
  org.openjfx/javafx-controls    {:mvn/version "25.0.4"}}

 :aliases
 {:run
  {:main-opts ["-m" "csv-cleaver.main"]
   :jvm-opts  ["--enable-native-access=ALL-UNNAMED"
               "-Dfile.encoding=UTF-8"]}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}

  :test
  ;; "dev" is here for the locale lint: the suite pins `bb locale-lint` clean
  ;; (csv-cleaver.text-test), so it has to be able to require dev/locale_lint.clj.
  ;; The runner still only looks in "test" for tests to run.
  {:extra-paths ["test" "dev"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd6605c"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                 "-Dfile.encoding=UTF-8"
                 "-Dtestfx.headless=true"]
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  :coverage
  {:extra-paths ["test" "dev"]
   :extra-deps  {cloverage/cloverage {:mvn/version "1.2.4"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                 "-Dfile.encoding=UTF-8"]
   :main-opts   ["-m" "cloverage.coverage"
                 "--src-ns-path" "src"
                 "--test-ns-path" "test"
                 "--output" "target/coverage"
                 "--text" "--html"]}

  ;; Draws the application icon and writes every platform asset. See
  ;; dev/icons.clj; run with `bb icons`.
  :icons
  {:extra-paths ["dev"]
   :extra-deps  {org.openjfx/javafx-swing {:mvn/version "25.0.4"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Dfile.encoding=UTF-8"]
   :main-opts   ["-m" "icons"]}

  ;; Renders every screen to target/shots as PNG, in both themes. Design review
  ;; without a display; also runs on CI.
  :shots
  {:extra-paths ["dev"]
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Dfile.encoding=UTF-8"]
   :main-opts   ["-m" "shots"]}

  ;; Known vulnerabilities in anything this ships. Checks the resolved
  ;; dependency tree against the NIST National Vulnerability Database.
  :audit
  {:replace-deps {nvd-clojure/nvd-clojure {:mvn/version "5.3.0"}
                  ;; Two patches past what nvd-clojure pins. 12.2.0 dies
                  ;; building a fresh NVD database: two 2026 Mozilla CVEs
                  ;; carry reference URLs longer than its VARCHAR(1000)
                  ;; column, so every clean CI runner failed while machines
                  ;; with old databases sailed on. Diagnosed from the H2
                  ;; error in the CI log after two rounds of blaming the
                  ;; runner network.
                  ;; 13.0.0 exists, but a major of the scanner is not drift:
                  ;; nvd-clojure 5.3 pins the 12 line, and a major typically
                  ;; changes the database schema, forcing every machine to
                  ;; rebuild its NVD mirror. Take it when nvd-clojure does.
                  org.owasp/dependency-check-core  {:mvn/version "12.2.2"}
                  org.owasp/dependency-check-utils {:mvn/version "12.2.2"}
                  org.clojure/clojure     {:mvn/version "1.12.6"}}
   :main-opts    ["-m" "nvd.task.check" "nvd-config.edn"]}

  ;; Dependencies that have moved on. Being behind is not itself a
  ;; vulnerability, but it is how you come to be running one.
  :outdated
  {:replace-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
   :main-opts    ["-m" "antq.core"]}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "build.clj"]}

  :format
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
   :main-opts    ["-m" "cljfmt.main"]}}}
